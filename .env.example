# Factify API Configuration

# Gemini API Key (Recommended - default model: gemini-2.5-flash / gemini-3.8-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Override Gemini Model name (e.g. gemini-2.5-flash, gemini-1.5-pro)
GEMINI_MODEL=gemini-2.5-flash

# NewsAPI Key (Required for live article search from newsapi.org)
NEWSAPI_KEY=your_newsapi_key_here

# Optional: OpenAI API Key (Fallback provider)
OPENAI_API_KEY=your_openai_api_key_here
